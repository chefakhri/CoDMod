# Timezone for the server clock, logs and the night exp bonus hours (cod_night_exp_from/to),
# e.g. Asia/Kuala_Lumpur, Europe/Warsaw. Names: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=UTC

SERVER_NAME=CoD Mod
# 1 = LAN mode (non-Steam clients allowed, only from private IPs). See DEPLOY.md "Docker".
SV_LAN=1
MAXPLAYERS=12
START_MAP=de_dust2
RCON_PASSWORD=change-me
SV_PASSWORD=
# Public URL of the fastdl service (plain HTTP, trailing slash), e.g. http://fastdl.example.com/
SV_DOWNLOADURL=

DB_USER=codmod
DB_PASS=change-me-too
DB_NAME=codmod

# In-game admin (players set: setinfo _pw <password>)
ADMIN_NAME=
ADMIN_PASSWORD=

YAPB_ENABLED=1
YAPB_QUOTA=6
YAPB_DIFFICULTY=2
YAPB_PASSWORD=
# How long bots wait in one spot (camping), in seconds. YaPB's own default is 15-45.
YAPB_CAMP_MIN=5
YAPB_CAMP_MAX=15

# Items: default = the items enabled in plugins-cod.ini, all = every item (see DEPLOY.md "Items")
COD_ITEMS=default

# Extra hlds_linux arguments, e.g. +sys_ticrate 1000
EXTRA_ARGS=
